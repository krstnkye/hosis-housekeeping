PORT=5000
DATABASE_URL=postgres://postgres:<password>@localhost:5432/hosis
# Required. Use a long private secret (at least 16 characters); the server
# will not start with an empty or example value.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Browser origins allowed to call the API (comma separated).
CORS_ORIGIN=http://localhost:5173
# Hotel time zone used for "today" in the database.
DB_TIME_ZONE=Asia/Manila
